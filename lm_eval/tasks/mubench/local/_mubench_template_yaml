dataset_path: aialt/MuBench
test_split: test
output_type: multiple_choice
# rstrip: some prompts (e.g. mmlu ar/he) end in "\n"; with the default " "
# target_delimiter the model would see "...:\n A"
doc_to_text: "{{prompt.rstrip()}}"
doc_to_choice: choices
doc_to_target: label
num_fewshot: 0
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
metadata:
  version: 0.0
