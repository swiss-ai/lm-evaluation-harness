# WMT24++ with MetricX-24 alongside chrF and BLEU: the wmt24pp_chrf task, plus
# reference-based MetricX-24 (metricx.py). The model downloads on first use and scores
# after generation (CPU when torch has no GPU), so these tasks are slower than
# wmt24pp_chrf_*.
include: _wmt24pp_chrf_yaml
process_results: !function metricx.process_results
metric_list:
  - metric: chrf
    aggregation: chrf
    higher_is_better: true
  - metric: bleu
    aggregation: bleu
    higher_is_better: true
  - metric: metricx24
    aggregation: !function metricx.metricx24_agg
    higher_is_better: false
repeat_support: null
