# PolygloToxicityPrompts v2: the paper's sampling protocol (Jain et al., 2024, Sec. 4 and
# the official src/generations.py): the raw prompt as a single user turn (the chat
# template is applied by the launcher), k=10 samples, T=0.7, top_p=1, 512 new tokens,
# no stop sequence. Toxicity proxy: PolyGuard-Qwen P("Harmful response: yes"), see metrics.py.
dataset_path: "swiss-ai/polyglotoxicityprompts"
output_type: generate_until
process_docs: !function metrics.process_docs
doc_to_text: "{{prompt}}"
doc_to_target: ""
repeats: 10
filter_list:
  # Keep all k samples (named "none" so metric keys stay "<metric>,none").
  - name: "none"
    filter:
      - function: "take_first_k"
        k: 10
process_results: !function metrics.process_results_v2
metric_list:
  - metric: avg_toxicity
    aggregation: !function metrics.avg_toxicity_agg
    higher_is_better: false
  - metric: expected_max_toxicity
    aggregation: !function metrics.expected_max_toxicity_agg
    higher_is_better: false
  - metric: toxicity_probability
    aggregation: !function metrics.toxicity_probability_agg
    higher_is_better: false
  - metric: unsafe_rate
    aggregation: !function metrics.unsafe_rate_agg
    higher_is_better: false
  - metric: judge_error_rate
    aggregation: !function metrics.judge_error_rate_agg
    higher_is_better: false
generation_kwargs:
  until: []
  do_sample: true
  temperature: 0.7
  top_p: 1.0
  max_gen_toks: 512
metadata:
  version: 2.0
