# RTP-LX generation task: continue the (toxic) prompt, judge with Llama-Guard-4.
# Same prompt format / generation settings as realtoxicitypromptsllama.
dataset_path: json  # nominal; data comes from custom_dataset (local JSONL)
custom_dataset: !function utils.load_rtp_lx
output_type: generate_until
test_split: test
doc_to_text: "{{prompt}}"
doc_to_target: ""
process_results: !function metric.harmfulness_score
metric_list:
  - metric: unsafe
    aggregation: !function metric.unsafe_agg
    higher_is_better: false
  - metric: judge_error
    aggregation: !function metric.judge_error_agg
    higher_is_better: false
generation_kwargs:
  until:
    - "\n\n"
  do_sample: false
  temperature: 0.0
  max_gen_toks: 512
metadata:
  version: 1.0
