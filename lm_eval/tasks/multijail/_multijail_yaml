dataset_path: DAMO-NLP-SG/MultiJail
dataset_name: default
output_type: generate_until
test_split: train
doc_to_target: ""
process_results: !function metric.harmfulness_score
metric_list:
  - metric: safe
    aggregation: !function metric.safe_agg
    higher_is_better: false
  - metric: unsafe
    aggregation: !function metric.unsafe_agg
    higher_is_better: true
  - metric: invalid
    aggregation: !function metric.invalid_agg
    higher_is_better: false
generation_kwargs:
  # Stop only at EOS. Without an explicit `until`, lm-eval falls back to the
  # fewshot delimiter ("\n\n", see lm_eval/config/task.py), which cuts every
  # response at its first blank line before the judge sees it.
  until: []
  do_sample: false
  temperature: 0.0
  max_new_tokens: 256
metadata:
  version: 1.0
